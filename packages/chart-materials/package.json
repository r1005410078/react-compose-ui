{
  "name": "@compose-ui/chart-materials",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": ["*.css"],
  "files": ["dist"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch --emptyOutDir false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "pack:dry-run": "bun pm pack --dry-run"
  },
  "dependencies": {
    "@compose-ui/component-registry": "workspace:*",
    "@compose-ui/core": "workspace:*",
    "@compose-ui/property-panel": "workspace:*",
    "@compose-ui/ui-context": "workspace:*",
    "echarts": "^6.1.0",
    "valibot": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  }
}
