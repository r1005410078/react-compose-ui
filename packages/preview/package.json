{
  "name": "@compose-ui/preview",
  "version": "1.0.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch --emptyOutDir false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "pack:dry-run": "vite build && bun pm pack --dry-run"
  },
  "dependencies": {
    "@compose-ui/animation": "workspace:*",
    "@compose-ui/assets": "workspace:*",
    "@compose-ui/component-registry": "workspace:*",
    "@compose-ui/core": "workspace:*",
    "@compose-ui/layout-engine": "workspace:*",
    "@compose-ui/script-runtime": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  }
}
