{
  "name": "@compose-ui/editor",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch --emptyOutDir false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "pack:dry-run": "vite build && bun pm pack --dry-run"
  },
  "dependencies": {
    "@compose-ui/asset-browser": "workspace:*",
    "@compose-ui/assets": "workspace:*",
    "@compose-ui/command-panel": "workspace:*",
    "@compose-ui/component-registry": "workspace:*",
    "@compose-ui/components": "workspace:*",
    "@compose-ui/core": "workspace:*",
    "@compose-ui/history": "workspace:*",
    "@compose-ui/layout-engine": "workspace:*",
    "@compose-ui/pages": "workspace:*",
    "@compose-ui/property-panel": "workspace:*",
    "@compose-ui/scene-tree": "workspace:*",
    "@compose-ui/script-runtime": "workspace:*",
    "@compose-ui/stage": "workspace:*",
    "@compose-ui/stage-engine": "workspace:*",
    "@compose-ui/ui-context": "workspace:*",
    "dockview-react": "^7.0.2",
    "valibot": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  }
}
